# ============================================================================
# AI Cold Outreach Platform - .gitignore
# ============================================================================

# Environment files (NEVER commit secrets!)
.env
.env.local
.env.production
.env.*.local
*.env
!.env.example

# VM settings with sensitive data
vm_settings.json

# Claude Code session/config (local only)
.claude/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
.eggs/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# Build outputs
dist/
build/
*.tar.gz
deploy_package_*/

# IDE & Editors
.idea/
.vscode/
*.swp
*.swo
*~
.cursor/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Lead-gen pipeline SQLite state (runtime data, not source)
backend/lead_gen_mcp/pipeline.db
backend/lead_gen_mcp/pipeline.db-wal
backend/lead_gen_mcp/pipeline.db-shm

# Logs
logs/
*.log
npm-debug.log*

# Test outputs
TEST*.xml
test_results*.json
coverage/
.coverage
htmlcov/

# Credentials (IMPORTANT!)
.git-credentials
.git-credentials.example
*.pem
*.key
credentials.json
token.json
gmail_token*.json

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
tmpclaude-*/
tmp_*.py
tmp_*.js
backend.pid
backend/MONGO_URI_AUDIT_STAGE*.txt

# Database dumps
*.sql
*.dump
mongo_export/

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Agent work files (cleanup after development)
AGENT*_*.txt
AGENT*_*.md
AGENT*_*.py

# Session files
writable/debugbar/
writable/session/

# Compiled files
*.class
*.jar
*.war
*.app
*.exe

# ML models (large files)
*.pkl
*.h5
*.model

# Jupyter checkpoints
.ipynb_checkpoints/

# Playwright
playwright-report/
test-results/

# E2E run artifacts
e2e_artifacts/

# Mailpool email lists (PII - kept local only)
mailpool_accounts.csv
mailpool_from_emails.csv
mailpool_gmail_api_emails.csv

# Finance exports (sensitive financial data - kept local only)
Invoice.csv
Invoices.csv
Bill.csv
Bills.csv

# Build logs
build-output.txt

# VM operational artifacts (backups, recovery dumps, local venvs)
*.bak-*
*_recovery.csv
lead_gen_venv/
backend/celerybeat-schedule

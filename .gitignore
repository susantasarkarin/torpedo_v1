# ============================================================================
# AI Cold Outreach Platform - .gitignore
# ============================================================================

# Environment files (NEVER commit secrets!)
.env
.env.local
.env.production
.env.*.local
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
.eggs/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# Build outputs
dist/
build/
*.tar.gz
deploy_package_*/

# IDE & Editors
.idea/
.vscode/
*.swp
*.swo
*~
.cursor/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
logs/
*.log
npm-debug.log*

# Test outputs
TEST*.xml
test_results*.json
coverage/
.coverage
htmlcov/

# Credentials (IMPORTANT!)
.git-credentials
.git-credentials.example
*.pem
*.key
credentials.json
token.json
gmail_token*.json

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# Database dumps
*.sql
*.dump
mongo_export/

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Agent work files (cleanup after development)
AGENT*_*.txt
AGENT*_*.md
AGENT*_*.py

# Session files
writable/debugbar/
writable/session/

# Compiled files
*.class
*.jar
*.war
*.app
*.exe

# ML models (large files)
*.pkl
*.h5
*.model

# Jupyter checkpoints
.ipynb_checkpoints/

# Playwright
playwright-report/
test-results/

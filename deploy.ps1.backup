# ============================================================================
# AI Cold Outreach Platform - Main Deployment Script (Windows PowerShell)
# ============================================================================
# This script automates the entire deployment process for the campaign platform
# including dependency installation, environment setup, and service startup.
#
# Usage: .\deploy.ps1
#
# Features:
#   - Checks system prerequisites (Python, Node.js)
#   - Installs backend and frontend dependencies
#   - Installs Playwright browsers
#   - Sets up environment variables
#   - Runs database migrations
#   - Starts all services
# ============================================================================

# Set error handling and ensure script stops on first error
$ErrorActionPreference = "Stop"

# ============================================================================
# CONFIGURATION
# ============================================================================
$ProjectRoot = Split-Path -Parent $MyInvocation.MyCommand.Path
$BackendDir = Join-Path $ProjectRoot "backend"
$FrontendDir = Join-Path $ProjectRoot "Campaign_platform"
$RequiredPythonVersion = 3.9
$RequiredNodeVersion = 18

# Color definitions
$Colors = @{
    Success = 'Green'
    Warning = 'Yellow'
    Error = 'Red'
    Info = 'Cyan'
    Progress = 'Magenta'
}

# ============================================================================
# UTILITY FUNCTIONS
# ============================================================================

function Write-Status {
    param(
        [string]$Message,
        [string]$Type = "Info",
        [string]$Symbol = "•"
    )
    
    switch ($Type) {
        "Success" { Write-Host "✅ $Message" -ForegroundColor $Colors.Success }
        "Warning" { Write-Host "⚠️  $Message" -ForegroundColor $Colors.Warning }
        "Error" { Write-Host "❌ $Message" -ForegroundColor $Colors.Error }
        "Progress" { Write-Host "🔄 $Message" -ForegroundColor $Colors.Progress }
        "Header" { Write-Host "`n════════════════════════════════════════════════════════════════`n$Message`n════════════════════════════════════════════════════════════════" -ForegroundColor $Colors.Info }
        "Step" { Write-Host "`n📋 $Message" -ForegroundColor $Colors.Info }
        default { Write-Host "$Symbol $Message" -ForegroundColor $Colors.Info }
    }
}

function Test-Command {
    param([string]$Command)
    return $null -ne (Get-Command $Command -ErrorAction SilentlyContinue)
}

function Get-VersionNumber {
    param([string]$Command)
    try {
        $output = & $Command --version 2>&1
        $version = $output -split '\n' | Select-Object -First 1
        return $version
    }
    catch {
        return $null
    }
}

function Test-PathExists {
    param([string]$Path)
    if (Test-Path $Path) {
        return $true
    }
    return $false
}

# ============================================================================
# PREREQUISITE CHECKS
# ============================================================================

function Check-Prerequisites {
    Write-Status "Checking system prerequisites..." "Step"
    
    $allChecksPassed = $true
    
    # Check Python
    if (-not (Test-Command "python")) {
        Write-Status "Python not found. Please install Python 3.9+" "Error"
        $allChecksPassed = $false
    } else {
        $version = Get-VersionNumber "python"
        Write-Status "Python found: $version" "Success"
    }
    
    # Check Node.js
    if (-not (Test-Command "npm")) {
        Write-Status "Node.js/npm not found. Please install Node.js 18+" "Error"
        $allChecksPassed = $false
    } else {
        $version = Get-VersionNumber "npm"
        Write-Status "Node.js/npm found: $version" "Success"
    }
    
    # Check Git
    if (-not (Test-Command "git")) {
        Write-Status "Git not found. Some features may not work." "Warning"
    } else {
        Write-Status "Git found" "Success"
    }
    
    if (-not $allChecksPassed) {
        Write-Status "Please install missing prerequisites and try again." "Error"
        exit 1
    }
    
    Write-Status "All prerequisites met!" "Success"
}

# ============================================================================
# ENVIRONMENT SETUP
# ============================================================================

function Setup-Environment {
    Write-Status "Setting up environment..." "Step"
    
    $envFile = Join-Path $ProjectRoot ".env"
    $envExampleFile = Join-Path $ProjectRoot ".env.example"
    
    if (-not (Test-PathExists $envFile)) {
        if (Test-PathExists $envExampleFile) {
            Write-Status "Creating .env from .env.example..." "Progress"
            Copy-Item $envExampleFile $envFile
            Write-Status ".env file created. Please update with your configuration." "Warning"
        } else {
            Write-Status ".env file not found. Please create it with required variables." "Warning"
        }
    } else {
        Write-Status ".env file exists" "Success"
    }
}

# ============================================================================
# DEPENDENCY INSTALLATION
# ============================================================================

function Install-BackendDependencies {
    Write-Status "Installing backend dependencies..." "Step"
    
    try {
        Push-Location $BackendDir
        
        if (-not (Test-PathExists "requirements.txt")) {
            Write-Status "requirements.txt not found in $BackendDir" "Error"
            return $false
        }
        
        Write-Status "Installing Python packages from requirements.txt..." "Progress"
        & python -m pip install --upgrade pip | Out-Null
        & python -m pip install -r requirements.txt
        
        Write-Status "Backend dependencies installed successfully" "Success"
        return $true
    }
    catch {
        Write-Status "Failed to install backend dependencies: $_" "Error"
        return $false
    }
    finally {
        Pop-Location
    }
}

function Install-FrontendDependencies {
    Write-Status "Installing frontend dependencies..." "Step"
    
    try {
        Push-Location $FrontendDir
        
        if (-not (Test-PathExists "package.json")) {
            Write-Status "package.json not found in $FrontendDir" "Error"
            return $false
        }
        
        Write-Status "Installing npm packages from package.json..." "Progress"
        & npm install
        
        Write-Status "Frontend dependencies installed successfully" "Success"
        return $true
    }
    catch {
        Write-Status "Failed to install frontend dependencies: $_" "Error"
        return $false
    }
    finally {
        Pop-Location
    }
}

function Install-PlaywrightBrowsers {
    Write-Status "Installing Playwright browsers..." "Step"
    
    try {
        Write-Status "Installing Chromium browser..." "Progress"
        & python -m playwright install chromium
        
        Write-Status "Playwright browsers installed successfully" "Success"
        return $true
    }
    catch {
        Write-Status "Failed to install Playwright browsers: $_" "Error"
        Write-Status "You can install manually later with: python -m playwright install chromium" "Warning"
        return $true  # Don't fail the entire deployment
    }
}

# ============================================================================
# DATABASE SETUP
# ============================================================================

function Setup-Database {
    Write-Status "Setting up database..." "Step"
    
    try {
        Push-Location $BackendDir
        
        # Check if migrations script exists
        $migrationScript = Join-Path $BackendDir "scripts" "run_migrations.py"
        if (Test-PathExists $migrationScript) {
            Write-Status "Running database migrations..." "Progress"
            & python $migrationScript
            Write-Status "Database migrations completed" "Success"
        } else {
            Write-Status "Migrations script not found at $migrationScript" "Warning"
            Write-Status "Skipping migrations. Run manually if needed: python backend/scripts/run_migrations.py" "Info"
        }
        
        return $true
    }
    catch {
        Write-Status "Database setup warning: $_" "Warning"
        return $true  # Don't fail the entire deployment
    }
    finally {
        Pop-Location
    }
}

# ============================================================================
# VERIFICATION
# ============================================================================

function Verify-Installation {
    Write-Status "Verifying installation..." "Step"
    
    # Check Python packages
    try {
        & python -c "import fastapi; import pymongo; import dotenv" 2>$null
        Write-Status "Core Python packages verified" "Success"
    }
    catch {
        Write-Status "Some Python packages may be missing" "Warning"
    }
    
    # Check npm packages
    try {
        Push-Location $FrontendDir
        if (Test-PathExists "node_modules") {
            Write-Status "Frontend node_modules verified" "Success"
        } else {
            Write-Status "Frontend node_modules not found" "Warning"
        }
        Pop-Location
    }
    catch {
        Write-Status "Could not verify frontend packages" "Warning"
    }
}

# ============================================================================
# MAIN DEPLOYMENT FLOW
# ============================================================================

function Main {
    Write-Status "🚀 AI Cold Outreach Platform - Deployment" "Header"
    
    Write-Status "Deployment starting at $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" "Info"
    Write-Status "Project root: $ProjectRoot" "Info"
    
    # Step 1: Check prerequisites
    Check-Prerequisites
    
    # Step 2: Setup environment
    Setup-Environment
    
    # Step 3: Install backend dependencies
    if (-not (Install-BackendDependencies)) {
        exit 1
    }
    
    # Step 4: Install frontend dependencies
    if (-not (Install-FrontendDependencies)) {
        exit 1
    }
    
    # Step 5: Install Playwright browsers
    Install-PlaywrightBrowsers
    
    # Step 6: Setup database
    Setup-Database
    
    # Step 7: Verify installation
    Verify-Installation
    
    # Success message
    Write-Status "Deployment completed successfully!" "Header"
    Write-Status "Next steps:" "Step"
    Write-Host "  1. Update .env file with your configuration"
    Write-Host "  2. Run: .\start_services.ps1     (Start all services)"
    Write-Host "  3. Run: .\health_check.ps1       (Check system health)"
    Write-Host "`nDocumentation:" -ForegroundColor $Colors.Info
    Write-Host "  • setup_environment.ps1  - Configure environment variables"
    Write-Host "  • install_dependencies.ps1 - Install/update dependencies"
    Write-Host "  • start_services.ps1     - Start backend, frontend, workers"
    Write-Host "  • health_check.ps1       - Verify all systems operational"
    
    Write-Status "Deployment finished at $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" "Info"
}

# Run main deployment
Main

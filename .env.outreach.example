# Torpedo Outreach System - Environment Configuration

# =============================================================================
# OpenAI Configuration (REQUIRED)
# =============================================================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7

# =============================================================================
# Database Configuration
# =============================================================================
# MongoDB (default)
MONGODB_URI=mongodb://localhost:27017/torpedo
MONGODB_DB_NAME=torpedo

# PostgreSQL (alternative)
# DATABASE_URL=postgresql://user:password@localhost:5432/torpedo

# =============================================================================
# Celery & Redis Configuration
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TIMEZONE=UTC

# =============================================================================
# Email Provider Configuration (Choose One)
# =============================================================================

# Option 1: SMTP (Gmail, Outlook, Custom)
SMTP_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Your Name

# Option 2: SendGrid
SENDGRID_API_KEY=sg-your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Your Company

# Option 3: Mailgun
MAILGUN_API_KEY=key-your-mailgun-key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM_EMAIL=noreply@yourdomain.com

# Option 4: Amazon SES
AWS_SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
SES_FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# Email Tracking
# =============================================================================
TRACKING_DOMAIN=track.torpedo.app
TRACKING_ENABLED=true
OPEN_TRACKING_ENABLED=true
CLICK_TRACKING_ENABLED=true

# =============================================================================
# Application Configuration
# =============================================================================
APP_NAME=Torpedo Outreach API
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# Outreach Guardrails & Limits
# =============================================================================
MAX_DAILY_EMAILS_PER_SENDER=50
MAX_HOURLY_EMAILS_PER_SENDER=10
MIN_LEAD_SCORE=60
MAX_EMAILS_PER_LEAD=4
MIN_DAYS_BETWEEN_EMAILS=3
MAX_BOUNCE_RATE=0.05
MAX_COMPLAINT_RATE=0.001
MIN_SENDER_HEALTH_SCORE=70.0

# =============================================================================
# Campaign Configuration
# =============================================================================
DEFAULT_CAMPAIGN_CTA_STYLE=soft
DEFAULT_SEND_START_HOUR=9
DEFAULT_SEND_END_HOUR=17
DEFAULT_SEND_TIMEZONE=UTC
DEFAULT_CAMPAIGN_DAILY_LIMIT=50

# =============================================================================
# Spam Check Configuration
# =============================================================================
SPAM_CHECK_ENABLED=true
SPAM_SCORE_THRESHOLD=30
SPAM_CHECK_EMAIL_BEFORE_SEND=true

# =============================================================================
# Authentication (for API)
# =============================================================================
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# Webhooks
# =============================================================================
WEBHOOK_SECRET=your-webhook-secret
SENDGRID_WEBHOOK_SECRET=sg-webhook-secret
MAILGUN_WEBHOOK_SECRET=mailgun-webhook-secret

# =============================================================================
# Monitoring & Logging
# =============================================================================
LOG_FILE=logs/app.log
SENTRY_DSN=optional-sentry-dsn
ENABLE_PERFORMANCE_MONITORING=false

# =============================================================================
# Development/Testing
# =============================================================================
TESTING=false
TEST_DATABASE_URL=mongodb://localhost:27017/torpedo_test
MOCK_AI_RESPONSES=false

# ============================================================================
# Dependency Installer (Windows PowerShell)
# ============================================================================
# This script installs and verifies all project dependencies including
# Python packages, Node.js packages, and Playwright browsers.
#
# Usage: .\install_dependencies.ps1 [-Update] [-Playwright]
#
# Parameters:
#   -Update       Force update all packages to latest versions
#   -Playwright   Include Playwright browser installation
# ============================================================================

param(
    [switch]$Update = $false,
    [switch]$Playwright = $true
)

$ErrorActionPreference = "Stop"

$ProjectRoot = Split-Path -Parent $MyInvocation.MyCommand.Path
$BackendDir = Join-Path $ProjectRoot "backend"
$FrontendDir = Join-Path $ProjectRoot "Campaign_platform"

# Color definitions
$Colors = @{
    Success = 'Green'
    Warning = 'Yellow'
    Error = 'Red'
    Info = 'Cyan'
    Progress = 'Magenta'
}

# ============================================================================
# UTILITY FUNCTIONS
# ============================================================================

function Write-Status {
    param(
        [string]$Message,
        [string]$Type = "Info",
        [string]$Symbol = "•"
    )
    
    switch ($Type) {
        "Success" { Write-Host "✅ $Message" -ForegroundColor $Colors.Success }
        "Warning" { Write-Host "⚠️  $Message" -ForegroundColor $Colors.Warning }
        "Error" { Write-Host "❌ $Message" -ForegroundColor $Colors.Error }
        "Progress" { Write-Host "🔄 $Message" -ForegroundColor $Colors.Progress }
        "Header" { Write-Host "`n════════════════════════════════════════════════════════════════`n$Message`n════════════════════════════════════════════════════════════════" -ForegroundColor $Colors.Info }
        "Step" { Write-Host "`n📋 $Message" -ForegroundColor $Colors.Info }
        default { Write-Host "$Symbol $Message" -ForegroundColor $Colors.Info }
    }
}

function Test-Command {
    param([string]$Command)
    return $null -ne (Get-Command $Command -ErrorAction SilentlyContinue)
}

function Get-VersionNumber {
    param([string]$Command, [string]$Pattern = "\d+\.\d+")
    try {
        $output = & $Command --version 2>&1
        $version = $output -split '\n' | Select-Object -First 1
        return $version
    }
    catch {
        return $null
    }
}

function Test-PathExists {
    param([string]$Path)
    return Test-Path $Path
}

function Test-PythonVersion {
    try {
        $output = & python -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')" 2>&1
        $version = [version]$output
        
        if ($version.Major -lt 3 -or ($version.Major -eq 3 -and $version.Minor -lt 9)) {
            return $false
        }
        return $true
    }
    catch {
        return $false
    }
}

function Test-NodeVersion {
    try {
        $output = & node --version 2>&1
        $version = $output -replace 'v', ''
        $version = [version]$version
        
        if ($version.Major -lt 18) {
            return $false
        }
        return $true
    }
    catch {
        return $false
    }
}

# ============================================================================
# VERSION CHECKS
# ============================================================================

function Check-Versions {
    Write-Status "Checking tool versions..." "Step"
    
    # Python
    if (-not (Test-Command "python")) {
        Write-Status "Python not found. Please install Python 3.9+" "Error"
        exit 1
    }
    
    if (-not (Test-PythonVersion)) {
        Write-Status "Python version is below 3.9. Please upgrade Python." "Error"
        exit 1
    }
    
    $pythonVersion = Get-VersionNumber "python"
    Write-Status "Python: $pythonVersion" "Success"
    
    # Node.js
    if (-not (Test-Command "npm")) {
        Write-Status "Node.js/npm not found. Please install Node.js 18+" "Error"
        exit 1
    }
    
    if (-not (Test-NodeVersion)) {
        Write-Status "Node.js version is below 18. Please upgrade Node.js." "Error"
        exit 1
    }
    
    $nodeVersion = Get-VersionNumber "node"
    $npmVersion = Get-VersionNumber "npm"
    Write-Status "Node.js: $nodeVersion" "Success"
    Write-Status "npm: $npmVersion" "Success"
}

# ============================================================================
# PYTHON DEPENDENCY INSTALLATION
# ============================================================================

function Install-PythonDependencies {
    Write-Status "Installing Python dependencies..." "Step"
    
    try {
        Push-Location $BackendDir
        
        if (-not (Test-PathExists "requirements.txt")) {
            Write-Status "requirements.txt not found in $BackendDir" "Error"
            return $false
        }
        
        # Upgrade pip
        Write-Status "Upgrading pip..." "Progress"
        & python -m pip install --upgrade pip | Out-Null
        Write-Status "pip upgraded" "Success"
        
        # Install requirements
        Write-Status "Installing packages from requirements.txt..." "Progress"
        if ($Update) {
            Write-Status "Using --upgrade flag to update existing packages" "Info"
            & python -m pip install --upgrade -r requirements.txt
        } else {
            & python -m pip install -r requirements.txt
        }
        
        Write-Status "Python dependencies installed" "Success"
        return $true
    }
    catch {
        Write-Status "Failed to install Python dependencies: $_" "Error"
        return $false
    }
    finally {
        Pop-Location
    }
}

function Verify-PythonPackages {
    Write-Status "Verifying Python packages..." "Step"
    
    $packages = @("fastapi", "pymongo", "python-dotenv", "uvicorn", "requests")
    $allFound = $true
    
    foreach ($package in $packages) {
        try {
            & python -c "import $($package -replace '-', '_')" 2>$null
            Write-Status "$package: installed" "Success"
        }
        catch {
            Write-Status "$package: NOT FOUND" "Warning"
            $allFound = $false
        }
    }
    
    return $allFound
}

# ============================================================================
# NODE.JS DEPENDENCY INSTALLATION
# ============================================================================

function Install-NodeDependencies {
    Write-Status "Installing Node.js dependencies..." "Step"
    
    try {
        Push-Location $FrontendDir
        
        if (-not (Test-PathExists "package.json")) {
            Write-Status "package.json not found in $FrontendDir" "Error"
            return $false
        }
        
        # Clear cache if updating
        if ($Update) {
            Write-Status "Clearing npm cache..." "Progress"
            & npm cache clean --force | Out-Null
        }
        
        Write-Status "Installing packages from package.json..." "Progress"
        if ($Update) {
            & npm update
        } else {
            & npm install
        }
        
        Write-Status "Node.js dependencies installed" "Success"
        return $true
    }
    catch {
        Write-Status "Failed to install Node.js dependencies: $_" "Error"
        return $false
    }
    finally {
        Pop-Location
    }
}

function Verify-NodePackages {
    Write-Status "Verifying Node.js packages..." "Step"
    
    try {
        Push-Location $FrontendDir
        
        if (-not (Test-PathExists "node_modules")) {
            Write-Status "node_modules directory not found" "Error"
            return $false
        }
        
        # Check for key packages
        $keyPackages = @("react", "vite")
        $allFound = $true
        
        foreach ($package in $keyPackages) {
            if (Test-PathExists "node_modules\$package") {
                Write-Status "$package: installed" "Success"
            } else {
                Write-Status "$package: NOT FOUND" "Warning"
                $allFound = $false
            }
        }
        
        Pop-Location
        return $allFound
    }
    catch {
        Write-Status "Error verifying Node.js packages: $_" "Error"
        return $false
    }
}

# ============================================================================
# PLAYWRIGHT INSTALLATION
# ============================================================================

function Install-PlaywrightBrowsers {
    if (-not $Playwright) {
        Write-Status "Skipping Playwright browser installation (-Playwright flag not set)" "Info"
        return $true
    }
    
    Write-Status "Installing Playwright browsers..." "Step"
    
    try {
        Write-Status "Installing Chromium browser (this may take a few minutes)..." "Progress"
        & python -m playwright install chromium
        
        Write-Status "Playwright browsers installed" "Success"
        return $true
    }
    catch {
        Write-Status "Failed to install Playwright browsers: $_" "Error"
        Write-Status "You can install manually later: python -m playwright install chromium" "Warning"
        return $true  # Don't fail entire process
    }
}

# ============================================================================
# SUMMARY AND REPORTING
# ============================================================================

function Show-Summary {
    Write-Status "Installation Summary" "Header"
    
    Write-Host @"
Dependency Installation Completed

✅ Installed:
   • Python packages (FastAPI, PyMongo, etc.)
   • Node.js packages (React, Vite, etc.)
   • Playwright browsers (Chromium)

Next Steps:
   1. Configure environment: .\setup_environment.ps1
   2. Run database migrations: python backend/scripts/run_migrations.py
   3. Start services: .\start_services.ps1

For more information:
   • Run: .\health_check.ps1         (System health check)
   • Review: .\.env.example          (Environment template)
   • Docs: README.md or README_CAMPAIGN_AUTOMATION.md
"@ -ForegroundColor $Colors.Success
}

# ============================================================================
# MAIN EXECUTION
# ============================================================================

function Main {
    Write-Status "Dependency Installer for AI Cold Outreach Platform" "Header"
    
    $updateFlag = if ($Update) { " (with --upgrade)" } else { "" }
    Write-Status "Starting dependency installation$updateFlag..." "Info"
    Write-Status "Timestamp: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" "Info"
    
    # Step 1: Check versions
    Check-Versions
    
    # Step 2: Install Python dependencies
    if (-not (Install-PythonDependencies)) {
        Write-Status "Stopping due to Python dependency installation failure." "Error"
        exit 1
    }
    
    # Step 3: Verify Python packages
    Verify-PythonPackages
    
    # Step 4: Install Node dependencies
    if (-not (Install-NodeDependencies)) {
        Write-Status "Stopping due to Node.js dependency installation failure." "Error"
        exit 1
    }
    
    # Step 5: Verify Node packages
    Verify-NodePackages
    
    # Step 6: Install Playwright
    Install-PlaywrightBrowsers
    
    # Show summary
    Show-Summary
    
    Write-Status "Installation finished at $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" "Info"
}

Main

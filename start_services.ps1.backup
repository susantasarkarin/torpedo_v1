# ============================================================================
# Service Starter (Windows PowerShell)
# ============================================================================
# This script starts all required services for the campaign platform:
# - Backend API server (FastAPI/Uvicorn)
# - Frontend development server (Vite)
# - Optional: Celery workers
# - Optional: Redis server
#
# Usage: .\start_services.ps1 [-BackendOnly] [-FrontendOnly] [-NoOpen]
#
# Parameters:
#   -BackendOnly    Start only backend server
#   -FrontendOnly   Start only frontend server
#   -NoOpen         Don't open browser when frontend starts
# ============================================================================

param(
    [switch]$BackendOnly = $false,
    [switch]$FrontendOnly = $false,
    [switch]$NoOpen = $false,
    [switch]$SkipRedis = $false
)

$ErrorActionPreference = "Continue"

$ProjectRoot = Split-Path -Parent $MyInvocation.MyCommand.Path
$BackendDir = Join-Path $ProjectRoot "backend"
$FrontendDir = Join-Path $ProjectRoot "Campaign_platform"

# Color definitions
$Colors = @{
    Success = 'Green'
    Warning = 'Yellow'
    Error = 'Red'
    Info = 'Cyan'
    Progress = 'Magenta'
}

# Hashtable to track started processes
$StartedProcesses = @{}

# ============================================================================
# UTILITY FUNCTIONS
# ============================================================================

function Write-Status {
    param(
        [string]$Message,
        [string]$Type = "Info",
        [string]$Symbol = "•"
    )
    
    switch ($Type) {
        "Success" { Write-Host "✅ $Message" -ForegroundColor $Colors.Success }
        "Warning" { Write-Host "⚠️  $Message" -ForegroundColor $Colors.Warning }
        "Error" { Write-Host "❌ $Message" -ForegroundColor $Colors.Error }
        "Progress" { Write-Host "🔄 $Message" -ForegroundColor $Colors.Progress }
        "Header" { Write-Host "`n════════════════════════════════════════════════════════════════`n$Message`n════════════════════════════════════════════════════════════════" -ForegroundColor $Colors.Info }
        "Step" { Write-Host "`n📋 $Message" -ForegroundColor $Colors.Info }
        "Running" { Write-Host "▶️  $Message" -ForegroundColor $Colors.Progress }
        default { Write-Host "$Symbol $Message" -ForegroundColor $Colors.Info }
    }
}

function Test-Command {
    param([string]$Command)
    return $null -ne (Get-Command $Command -ErrorAction SilentlyContinue)
}

function Test-Port {
    param([int]$Port)
    try {
        $tcp = New-Object System.Net.Sockets.TcpClient
        $tcp.Connect("127.0.0.1", $Port)
        $tcp.Close()
        return $true
    }
    catch {
        return $false
    }
}

function Wait-Port {
    param([int]$Port, [int]$TimeoutSeconds = 30)
    
    $elapsed = 0
    $interval = 1
    
    while ($elapsed -lt $TimeoutSeconds) {
        if (Test-Port $Port) {
            return $true
        }
        Start-Sleep -Seconds $interval
        $elapsed += $interval
    }
    
    return $false
}

function Test-PathExists {
    param([string]$Path)
    return Test-Path $Path
}

# ============================================================================
# PREREQUISITE CHECKS
# ============================================================================

function Check-Prerequisites {
    Write-Status "Checking prerequisites..." "Step"
    
    # Check Python
    if (-not (Test-Command "python")) {
        Write-Status "Python not found!" "Error"
        exit 1
    }
    Write-Status "Python: ✓" "Success"
    
    # Check Node.js
    if (-not (Test-Command "npm")) {
        Write-Status "Node.js/npm not found!" "Error"
        exit 1
    }
    Write-Status "Node.js/npm: ✓" "Success"
    
    # Check .env file
    $envFile = Join-Path $ProjectRoot ".env"
    if (-not (Test-PathExists $envFile)) {
        Write-Status ".env file not found! Run: .\setup_environment.ps1" "Error"
        exit 1
    }
    Write-Status ".env file: ✓" "Success"
}

# ============================================================================
# SERVICE STARTUP FUNCTIONS
# ============================================================================

function Start-BackendServer {
    Write-Status "Starting backend server..." "Step"
    
    try {
        # Check if backend directory exists
        if (-not (Test-PathExists $BackendDir)) {
            Write-Status "Backend directory not found: $BackendDir" "Error"
            return $false
        }
        
        # Check if main.py exists
        $mainFile = Join-Path $BackendDir "main.py"
        if (-not (Test-PathExists $mainFile)) {
            Write-Status "main.py not found in backend directory" "Error"
            return $false
        }
        
        Write-Status "Launching Uvicorn server (FastAPI)..." "Progress"
        
        # Start backend in a new window
        $backendProcess = Start-Process `
            -FilePath "python" `
            -ArgumentList "-m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000" `
            -WorkingDirectory $BackendDir `
            -NoNewWindow `
            -PassThru
        
        $StartedProcesses["Backend"] = $backendProcess
        
        Write-Status "Backend started (PID: $($backendProcess.Id))" "Running"
        Write-Status "Waiting for backend to be ready on port 8000..." "Progress"
        
        # Wait for backend to be ready
        if (Wait-Port 8000 30) {
            Write-Status "Backend is ready at http://localhost:8000" "Success"
            Write-Status "API docs available at http://localhost:8000/docs" "Info"
            return $true
        } else {
            Write-Status "Backend did not respond within timeout" "Warning"
            Write-Status "Check backend console for errors" "Info"
            return $false
        }
    }
    catch {
        Write-Status "Failed to start backend: $_" "Error"
        return $false
    }
}

function Start-FrontendServer {
    Write-Status "Starting frontend development server..." "Step"
    
    try {
        # Check if frontend directory exists
        if (-not (Test-PathExists $FrontendDir)) {
            Write-Status "Frontend directory not found: $FrontendDir" "Error"
            return $false
        }
        
        # Check if package.json exists
        $packageFile = Join-Path $FrontendDir "package.json"
        if (-not (Test-PathExists $packageFile)) {
            Write-Status "package.json not found in frontend directory" "Error"
            return $false
        }
        
        Write-Status "Launching Vite development server..." "Progress"
        
        # Start frontend in a new window
        $frontendProcess = Start-Process `
            -FilePath "npm" `
            -ArgumentList "run dev" `
            -WorkingDirectory $FrontendDir `
            -NoNewWindow `
            -PassThru
        
        $StartedProcesses["Frontend"] = $frontendProcess
        
        Write-Status "Frontend started (PID: $($frontendProcess.Id))" "Running"
        Write-Status "Waiting for frontend to be ready on port 5173..." "Progress"
        
        # Wait for frontend to be ready
        if (Wait-Port 5173 30) {
            Write-Status "Frontend is ready at http://localhost:5173" "Success"
            
            # Open browser if not skipped
            if (-not $NoOpen) {
                Write-Status "Opening browser..." "Progress"
                Start-Process "http://localhost:5173"
            }
            return $true
        } else {
            Write-Status "Frontend did not respond within timeout" "Warning"
            Write-Status "Check frontend console for errors" "Info"
            return $true  # Don't fail, might just be slow
        }
    }
    catch {
        Write-Status "Failed to start frontend: $_" "Error"
        return $false
    }
}

function Start-CeleryWorker {
    Write-Status "Starting Celery worker..." "Step"
    
    try {
        if (-not (Test-Command "celery")) {
            Write-Status "Celery not installed, skipping worker startup" "Warning"
            return $true
        }
        
        Write-Status "Launching Celery worker..." "Progress"
        
        $celeryProcess = Start-Process `
            -FilePath "python" `
            -ArgumentList "-m celery -A backend.celery_app worker --loglevel=info" `
            -WorkingDirectory $ProjectRoot `
            -NoNewWindow `
            -PassThru
        
        $StartedProcesses["Celery"] = $celeryProcess
        
        Write-Status "Celery worker started (PID: $($celeryProcess.Id))" "Running"
        return $true
    }
    catch {
        Write-Status "Failed to start Celery: $_" "Warning"
        return $true  # Don't fail
    }
}

function Start-RedisServer {
    if ($SkipRedis) {
        Write-Status "Skipping Redis (--SkipRedis flag set)" "Info"
        return $true
    }
    
    Write-Status "Checking Redis availability..." "Step"
    
    try {
        if (-not (Test-Command "redis-server")) {
            Write-Status "Redis not installed locally, skipping startup" "Warning"
            Write-Status "Install Redis or configure REDIS_URL in .env" "Info"
            return $true
        }
        
        Write-Status "Launching Redis server..." "Progress"
        
        $redisProcess = Start-Process `
            -FilePath "redis-server" `
            -NoNewWindow `
            -PassThru
        
        $StartedProcesses["Redis"] = $redisProcess
        
        Write-Status "Redis started (PID: $($redisProcess.Id))" "Running"
        
        # Wait for Redis to be ready
        if (Wait-Port 6379 10) {
            Write-Status "Redis is ready at localhost:6379" "Success"
            return $true
        } else {
            Write-Status "Redis did not respond within timeout" "Warning"
            return $true
        }
    }
    catch {
        Write-Status "Failed to start Redis: $_" "Warning"
        return $true  # Don't fail
    }
}

# ============================================================================
# STATUS AND MONITORING
# ============================================================================

function Show-Status {
    Write-Status "Service Status" "Header"
    
    Write-Host "Running Services:" -ForegroundColor $Colors.Info
    Write-Host ""
    
    foreach ($service in $StartedProcesses.Keys) {
        $process = $StartedProcesses[$service]
        
        if ($null -ne $process -and -not $process.HasExited) {
            $status = "✅ Running"
            $statusColor = $Colors.Success
        } else {
            $status = "❌ Stopped"
            $statusColor = $Colors.Error
        }
        
        Write-Host "  $service ($status) - PID: $($process.Id)" -ForegroundColor $statusColor
    }
    
    Write-Host ""
    Write-Host "Access Points:" -ForegroundColor $Colors.Info
    Write-Host "  Backend API:   http://localhost:8000" -ForegroundColor $Colors.Info
    Write-Host "  API Docs:      http://localhost:8000/docs" -ForegroundColor $Colors.Info
    Write-Host "  Frontend:      http://localhost:5173" -ForegroundColor $Colors.Info
    
    if ($StartedProcesses.ContainsKey("Redis")) {
        Write-Host "  Redis:         localhost:6379" -ForegroundColor $Colors.Info
    }
    
    Write-Host ""
}

function Setup-ExitHandler {
    Write-Status "Setting up shutdown handler..." "Info"
    Write-Host "Press Ctrl+C to stop all services" -ForegroundColor $Colors.Warning
    
    # Register Ctrl+C handler
    $null = Register-EngineEvent -SourceIdentifier PowerShell.Exiting -Action {
        Write-Status "Shutting down services..." "Step"
        
        foreach ($service in $StartedProcesses.Keys) {
            $process = $StartedProcesses[$service]
            if ($null -ne $process -and -not $process.HasExited) {
                Write-Status "Stopping $service (PID: $($process.Id))..." "Progress"
                $process.Kill()
                $process.WaitForExit()
                Write-Status "$service stopped" "Success"
            }
        }
        
        Write-Status "All services have been shut down" "Success"
    }
}

# ============================================================================
# MAIN EXECUTION
# ============================================================================

function Main {
    Write-Status "AI Cold Outreach Platform - Service Starter" "Header"
    
    Write-Status "Startup time: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" "Info"
    
    # Check prerequisites
    Check-Prerequisites
    
    # Determine which services to start
    if (-not $FrontendOnly) {
        if (-not (Start-BackendServer)) {
            Write-Status "Warning: Backend failed to start properly" "Warning"
        }
        Start-CeleryWorker
        Start-RedisServer
    }
    
    if (-not $BackendOnly) {
        if (-not (Start-FrontendServer)) {
            Write-Status "Warning: Frontend failed to start properly" "Warning"
        }
    }
    
    # Show status
    Show-Status
    
    # Setup exit handler
    Setup-ExitHandler
    
    # Keep script running
    Write-Host ""
    Write-Status "Waiting for services to run. Press Ctrl+C to stop all services." "Info"
    
    try {
        while ($true) {
            # Check if any process has exited unexpectedly
            foreach ($service in $StartedProcesses.Keys) {
                $process = $StartedProcesses[$service]
                if ($process.HasExited) {
                    Write-Status "$service has unexpectedly exited (exit code: $($process.ExitCode))" "Warning"
                }
            }
            
            Start-Sleep -Seconds 5
        }
    }
    catch {
        # Handle Ctrl+C gracefully
        Write-Status "Received stop signal" "Progress"
    }
}

Main

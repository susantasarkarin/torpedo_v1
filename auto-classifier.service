[Unit]
Description=Auto Classification Agent for Campaign Platform
After=network.target mongod.service
Wants=mongod.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/campaign_platform/backend
Environment=PATH=/var/www/campaign_platform/backend/venv/bin:/usr/bin
Environment=PYTHONPATH=/var/www/campaign_platform/backend
ExecStart=/var/www/campaign_platform/backend/venv/bin/python -m leads.auto_classifier_agent
Restart=always
RestartSec=10
StandardOutput=append:/var/log/auto_classifier.log
StandardError=append:/var/log/auto_classifier.log

[Install]
WantedBy=multi-user.target

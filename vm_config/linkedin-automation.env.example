# LinkedIn Automation Environment Configuration
# Location: /etc/torpedo/linkedin-automation.env
# 
# This file contains environment variables for LinkedIn automation services.
# Keep this file secure - it contains encrypted credentials reference.

# ============================================
# LinkedIn Encryption
# ============================================
# Generate a new key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LINKEDIN_ENCRYPTION_KEY=your-encryption-key-here

# ============================================
# Selenium/WebDriver Configuration
# ============================================
# Path to chromedriver executable (optional)
# If not set, will use system-installed chromedriver
CHROMEDRIVER_PATH=/usr/bin/chromedriver

# ============================================
# Browser Configuration
# ============================================
# Run browser in headless mode (recommended for servers)
LINKEDIN_BROWSER_HEADLESS=true

# Browser timeout in seconds
LINKEDIN_BROWSER_TIMEOUT=20

# ============================================
# Automation Limits
# ============================================
# Max connections to send per run
LINKEDIN_MAX_CONNECTIONS=10

# Max messages to send per run
LINKEDIN_MAX_MESSAGES=5

# Max posts to interact with per run
LINKEDIN_MAX_POSTS=100

# ============================================
# Scheduler Configuration
# ============================================
# Daily automation start time (HH:MM UTC)
LINKEDIN_RUN_TIME=02:00

# Enable/disable LinkedIn automation scheduler
LINKEDIN_SCHEDULER_ENABLED=true

# ============================================
# Logging
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LINKEDIN_LOG_LEVEL=INFO

# Log file location
LINKEDIN_LOG_FILE=/var/log/torpedo/linkedin-automation.log

# ============================================
# Database
# ============================================
# MongoDB connection string (inherited from main Torpedo config)
# This will be set by main system environment
MONGODB_URI=mongodb://root:PASSWORD@localhost:27017/torpedo?authSource=admin

# ============================================
# Celery Configuration
# ============================================
# Redis broker URL
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend
CELERY_RESULT_BACKEND=redis://localhost:6379/1

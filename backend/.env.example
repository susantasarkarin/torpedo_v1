# Backend Environment Variables

# MongoDB Configuration (can also be configured via Settings UI)
MONGO_URI=mongodb://localhost:27017/email_automation

# Session Management
SESSION_SECRET=supersecretkey_change_this_in_production

# API Base URL (optional)
API_BASE=http://localhost:9944
SESSION_TTL_SECONDS=86400

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:9945,http://34.41.181.74

# CPX Research Configuration (can also be configured via Settings UI - profile > settings)
# If set in Settings UI, those values take precedence over these env vars
CPX_APP_ID=
CPX_EXT_USER_ID=
CPX_SECURE_HASH_KEY=
CPX_API_TIMEOUT=30
CPX_FETCH_LIMIT=1000

# Gmail API Configuration (for OAuth)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:9944/gmail/auth/callback

# AI Classification (Gemini FREE tier is default)
# ================================================
# RECOMMENDED: Use 6-7 Gemini API keys for FREE tier (6000-7000 requests/day)

# Option 1: Comma-separated list of Gemini API keys
GEMINI_API_KEYS=key1,key2,key3,key4,key5,key6,key7

# Option 2: Numbered keys (GEMINI_API_KEY_1 through GEMINI_API_KEY_20)
# GEMINI_API_KEY_1=AIza...
# GEMINI_API_KEY_2=AIza...
# GEMINI_API_KEY_3=AIza...
# GEMINI_API_KEY_4=AIza...
# GEMINI_API_KEY_5=AIza...
# GEMINI_API_KEY_6=AIza...
# GEMINI_API_KEY_7=AIza...

# Option 3: Single key (limited to 1000 requests/day)
# GEMINI_API_KEY=your_gemini_api_key

# Default AI provider (gemini = FREE, openai/anthropic = costs money)
AI_DEFAULT_PROVIDER=gemini

# FALLBACK PROVIDERS (only used if Gemini fails or is disabled)
# OpenAI - costs ~$0.15/1K emails
OPENAI_API_KEY=

# Anthropic Claude - costs ~$3/1K emails (for premium quality tasks only)
ANTHROPIC_API_KEY=




# Backend Environment Variables

# MongoDB Configuration
MONGO_URI=mongodb://campaign_mongo:27017/email_automation

# MailerSend Configuration
MAILERSEND_API_KEY=your_mailersend_api_key_here
SENDER_EMAIL=your_sender_email@example.com

# Session Management
SESSION_SECRET=supersecretkey_change_this_in_production

# API Base URL (optional)
API_BASE=http://localhost:9944
SESSION_TTL_SECONDS=86400

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:9945,http://34.14.202.129

# CPX Research Configuration
CPX_APP_ID=your_cpx_app_id_here
CPX_EXT_USER_ID=your_cpx_ext_user_id_here
CPX_SECURE_HASH_KEY=your_cpx_secure_hash_key_here
CPX_API_TIMEOUT=30
CPX_FETCH_LIMIT=1000




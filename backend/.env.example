# Backend Environment Variables

# MongoDB Configuration (can also be configured via Settings UI)
MONGO_URI=mongodb://localhost:27017/email_automation

# Session Management
SESSION_SECRET=supersecretkey_change_this_in_production

# API Base URL (optional)
API_BASE=http://localhost:9944
SESSION_TTL_SECONDS=86400

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:9945,http://139.59.32.72

# CPX Research Configuration (can also be configured via Settings UI - profile > settings)
# If set in Settings UI, those values take precedence over these env vars
CPX_APP_ID=
CPX_EXT_USER_ID=
CPX_SECURE_HASH_KEY=
CPX_API_TIMEOUT=30
CPX_FETCH_LIMIT=1000

# Gmail API Configuration (for OAuth)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:9944/gmail/auth/callback

# AI Provider (AWS Bedrock Mantle — serverless, OpenAI-compatible, per-token billed)
# ====================================
# All calls route through ai_governance (daily limits + audit logging).
# zai.glm-4.7-flash handles high-volume classification; deepseek.v3.2 handles
# generation/research. Billed through the same AWS account as SES — generate
# a key at AWS Console -> Bedrock -> API keys (scope it to the region below).

AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MANTLE_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_MANTLE_ANTHROPIC_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/anthropic
BEDROCK_MODEL_CHEAP=zai.glm-4.7-flash
BEDROCK_MODEL_PREMIUM=deepseek.v3.2
BEDROCK_MODEL_WEB_SEARCH=anthropic.claude-haiku-4-5

AI_DEFAULT_PROVIDER=bedrock




# Backend Environment Variables

# MongoDB Configuration (can also be configured via Settings UI)
MONGO_URI=mongodb://localhost:27017/email_automation

# Session Management
SESSION_SECRET=supersecretkey_change_this_in_production

# API Base URL (optional)
API_BASE=http://localhost:9944
SESSION_TTL_SECONDS=86400

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:9945,http://139.59.32.72

# CPX Research Configuration (can also be configured via Settings UI - profile > settings)
# If set in Settings UI, those values take precedence over these env vars
CPX_APP_ID=
CPX_EXT_USER_ID=
CPX_SECURE_HASH_KEY=
CPX_API_TIMEOUT=30
CPX_FETCH_LIMIT=1000

# Gmail API Configuration (for OAuth)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:9944/gmail/auth/callback

# AI Provider (AWS Bedrock Mantle — serverless, OpenAI-compatible, per-token billed)
# ====================================
# All calls route through ai_governance (daily limits + audit logging).
# zai.glm-4.7-flash handles high-volume classification; deepseek.v3.2 handles
# generation/research. Billed through the same AWS account as SES — generate
# a key at AWS Console -> Bedrock -> API keys (scope it to the region below).

AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MANTLE_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_MANTLE_ANTHROPIC_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/anthropic
BEDROCK_MODEL_CHEAP=zai.glm-4.7-flash
BEDROCK_MODEL_PREMIUM=deepseek.v3.2
BEDROCK_MODEL_WEB_SEARCH=anthropic.claude-haiku-4-5

AI_DEFAULT_PROVIDER=bedrock




# ---------------------------------------------------------------
# Self-hosted GLM-5.2 (vLLM on a rented GPU node)
# ---------------------------------------------------------------
# vLLM serves an OpenAI-compatible API, so the `local:` prefix routes here
# with no code change. Reach the node over an SSH tunnel — do not bind the
# vLLM port to a public interface, it has no auth of its own.
#
# SELF_HOSTED_BASE_URL=http://127.0.0.1:8000/v1
# SELF_HOSTED_API_KEY=not-required
# BEDROCK_MODEL_SMART=local:zai-org/GLM-5.2
#
# GLM-5.2 thinks by default and will spend the whole max_tokens budget on
# reasoning, returning empty content. Self-hosted vLLM disables that with
# chat_template_kwargs — NOT the `thinking` key Z.ai's hosted API uses:
#
# SELF_HOSTED_EXTRA_PARAMS={"chat_template_kwargs":{"enable_thinking":false}}
#
# Alternatively set it once on the server with --default-chat-template-kwargs
# and leave SELF_HOSTED_EXTRA_PARAMS empty.

# ---------------------------------------------------------------
# On-demand GPU leases (scripts/run_on_gpu.py)
# ---------------------------------------------------------------
# A leased 8xH200 costs ~$35/hr, so an orphaned pod is ~$843/day. Run the
# reaper from cron on a host that is NOT the one launching jobs:
#   */15 * * * * cd /var/www/campaign_platform/backend && \
#       python -m infra.gpu_lease reap --max-age 120
#
# RUNPOD_API_KEY=
# RUNPOD_API_BASE=https://rest.runpod.io/v1   # v1 retires 2026-11-15
# GPU_HOURLY_RATE=35.12                       # cost line in the run summary

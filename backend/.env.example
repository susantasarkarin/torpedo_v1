# Backend Environment Variables

# MongoDB Configuration (can also be configured via Settings UI)
MONGO_URI=mongodb://localhost:27017/email_automation

# Session Management
SESSION_SECRET=supersecretkey_change_this_in_production

# API Base URL (optional)
API_BASE=http://localhost:9944
SESSION_TTL_SECONDS=86400

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:9945,http://139.59.32.72

# CPX Research Configuration (can also be configured via Settings UI - profile > settings)
# If set in Settings UI, those values take precedence over these env vars
CPX_APP_ID=
CPX_EXT_USER_ID=
CPX_SECURE_HASH_KEY=
CPX_API_TIMEOUT=30
CPX_FETCH_LIMIT=1000

# Gmail API Configuration (for OAuth)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:9944/gmail/auth/callback

# AI Provider (Kimi / Moonshot, via its Anthropic-compatible endpoint)
# ====================================
# All calls route through ai_governance (daily limits + audit logging).
# kimi-k2.6 handles high-volume classification; kimi-k3 handles
# generation/research. Requires a Moonshot account funded with at least
# $1 at platform.moonshot.ai — get the key from there.

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/anthropic
KIMI_MODEL_CHEAP=kimi-k2.6
KIMI_MODEL_PREMIUM=kimi-k3

AI_DEFAULT_PROVIDER=kimi




# Backend Environment Variables

# MongoDB Configuration (can also be configured via Settings UI)
MONGO_URI=mongodb://localhost:27017/email_automation

# Session Management
SESSION_SECRET=supersecretkey_change_this_in_production

# API Base URL (optional)
API_BASE=http://localhost:9944
SESSION_TTL_SECONDS=86400

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:9945,http://139.59.32.72

# CPX Research Configuration (can also be configured via Settings UI - profile > settings)
# If set in Settings UI, those values take precedence over these env vars
CPX_APP_ID=
CPX_EXT_USER_ID=
CPX_SECURE_HASH_KEY=
CPX_API_TIMEOUT=30
CPX_FETCH_LIMIT=1000

# Gmail API Configuration (for OAuth)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:9944/gmail/auth/callback

# AI Provider (Anthropic Messages API — the only provider)
# ====================================
# Ladder: rules -> Haiku -> Sonnet -> review queue (platform_core/ladder.py).
# All calls route through ai_governance (daily limits + audit logging).
# Models are set in the ladder config (platform_core/ladder.py): claude-haiku-5-5 (tier 1)
# and claude-sonnet-5-5 (tier 2). The ladder reads no model env var.
# LLM_MODEL_* below are read only by ai_governance/claude_gateway.py and lead_gen_mcp/llm_client.py.

ANTHROPIC_API_KEY=
# LLM_MODEL_FAST=claude-haiku-5-5
# LLM_MODEL_SMART=claude-sonnet-5-5
# LLM_MODEL_WEB_SEARCH=claude-haiku-5-5
AI_DAILY_LIMIT=50000
# Legacy fallback, read only when AI_DAILY_LIMIT is unset:
# GEMINI_DAILY_LIMIT=50000

# Mail-AI (sales/mail_pool_ai.py, sales/mail_ai_switch.py). Master switch is OFF by default.
# MAIL_AI_ENABLED=false
# MAIL_AI_ANALYSIS_ROLE=cheap
# MAIL_AI_WRITER_ROLE=smart
# MAIL_AI_ANALYSIS_MAX_TOKENS=1500
# MAIL_AI_SCAN_MAX_TOKENS=2500
# MAIL_AI_MAX_PER_RUN=200
# MAIL_AI_PREFILTER_ENABLED=true
# MAIL_AI_PREFILTER_MIN_CONFIDENCE=0.5
# MAIL_AI_PREFILTER_AUDIT_SAMPLE=20
# MAIL_AI_RFQ_PIPELINE=two_stage

# Optional, read only by legacy batch modules (leads/bedrock_client.py, leads/ingestion*.py,
# leads/openai_rotator.py). Leave unset unless you run those. Not used by ai_governance.
# BEDROCK_BATCH_S3_BUCKET=
# BEDROCK_BATCH_ROLE_ARN=
# BEDROCK_MODEL_CHEAP=qwen.qwen3-32b-v1:0
# BEDROCK_MODEL_SMART=
# BEDROCK_FAILOVER_MEMORY_SECONDS=300
# BEDROCK_MAX_RETRIES=3
# OPENAI_API_KEY=




# AI survey allocation for SurveyFieldwork panelists (services/ai_allocation.py).
# Fraction of panel CINT traffic the AI re-ranks; 0 = off. The rest is the
# control group (traffic records carry aiAllocation.ranked for comparison).
AI_ALLOCATION_SHARE=0
AI_ALLOCATION_TIMEOUT=2.5
PANEL_API_URL=
PANEL_INTERNAL_KEY=

# ====================================
# Ad-platform pixels (thank-you page on /surveycomplete for ad traffic)
# A platform renders only when enabled AND its ID is set.
# ====================================
META_PIXEL_ENABLED=true
META_PIXEL_ID=192934514575015
# Quora ad traffic (utm_source=quora or qclid). ID = 32-char hex from Quora Ads Manager > Pixel.
QUORA_PIXEL_ENABLED=true
QUORA_PIXEL_ID=aa2e7a4e1314e712f4c6d5cc85d8a96d
# TEMPORARY setup testing: terminated ad respondents also fire the pixel. Keep false in normal operation.
AD_PIXEL_FIRE_ON_TERMINATE=false
# TODO(meta-capi): server-side Conversions API token (not used yet)
META_CAPI_ACCESS_TOKEN=
GOOGLE_ADS_ENABLED=false
GOOGLE_ADS_TAG_ID=
TIKTOK_PIXEL_ENABLED=false
TIKTOK_PIXEL_ID=

# ====================================
# SFW respondent quality score (project traffic) — services/respondent_quality.py
# Needs migration 007 indexes before SFW_SCORE_ENABLED=true (lookups run at survey entry).
# ====================================
SFW_SCORE_ENABLED=false
# false = flag-only (score + store, nobody turned away); true = block-band entries are terminated
SFW_SCORE_ENFORCE=false
SFW_BLOCK_BELOW=40
SFW_REVIEW_BELOW=70
# IPQualityScore key for VPN/proxy/datacenter checks (unset = skipped); lookups are cached 7 days per IP
IPQS_API_KEY=
IPQS_MONTHLY_LIMIT=5000

# ====================================
# Survey qualification & routing engine — services/survey_routing.py (migration 009)
# ====================================
# Router links (/takesurvey?api=false&route=1&vid=..&rid=..) and re-routing after a client
# terminate / quota-full to the next eligible survey. Projects opt in with "Accept routed respondents".
SURVEY_ROUTING_ENABLED=false
# Respondent's IP country (Cloudflare) must match the project country; otherwise route to their country's surveys
COUNTRY_ROUTING_ENABLED=false
ROUTING_MAX_ATTEMPTS=3
# Linked from the Paid Ads consent checkbox (name / email / phone -> SurveyFieldwork panel invite)
SFW_PRIVACY_POLICY_URL=https://surveyfieldwork.com/privacy-policy

# Campaign Platform - Environment Configuration
# Copy this file to .env and update values as needed

# ============== DATABASE ==============
# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/

# ============== SERVER ==============
# API base URL (used for email tracking links)
API_BASE=http://localhost:8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ============== AUTHENTICATION ==============
# Secret key for session token signing (CHANGE IN PRODUCTION!)
SESSION_SECRET=your-super-secret-key-change-in-production

# Session TTL in seconds (default: 24 hours)
SESSION_TTL_SECONDS=86400

# ============== CPX RESEARCH API ==============
# CPX Research credentials for survey inventory
CPX_APP_ID=
CPX_EXT_USER_ID=
CPX_SECURE_HASH_KEY=

# API timeout in seconds
CPX_API_TIMEOUT=30

# Maximum surveys to fetch per request
CPX_FETCH_LIMIT=1000

# ============== OPENAI API ==============
# OpenAI API key for AI classification features
OPENAI_API_KEY=sk-...

# Set to 'true' to disable all OpenAI API calls (cost control)
DISABLE_OPENAI_CALLS=false

# ============== GOOGLE APIS ==============
# Google Custom Search API key
GOOGLE_API_KEY=

# Google Custom Search Engine ID
GOOGLE_CSE_ID=

# Path to Google Sheets service account JSON
GOOGLE_SHEETS_SERVICE_ACCOUNT=

# Google CSE Rate Limiting (for $50/month budget)
# Daily query limit
GOOGLE_CSE_DAILY_LIMIT=400

# Hourly query limit
GOOGLE_CSE_HOURLY_LIMIT=50

# Delay between queries in seconds
GOOGLE_CSE_QUERY_DELAY=3

# Monthly budget in USD
GOOGLE_CSE_MONTHLY_BUDGET=50.0

# Enable rate limiting
GOOGLE_CSE_RATE_LIMIT_ENABLED=true

# ============== EMAIL/IMAP ==============
# Default IMAP settings (can be overridden per account)
# IMAP_SERVER=imap.gmail.com
# IMAP_PORT=993
# IMAP_USE_SSL=true

# ============== LOGGING ==============
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============== DEVELOPMENT ==============
# Enable debug mode (additional logging, error details)
DEBUG=false

# ============== PRODUCTION NOTES ==============
# 1. ALWAYS change SESSION_SECRET in production
# 2. Use strong, unique API keys
# 3. Set appropriate CORS_ORIGINS for your domains
# 4. Configure rate limits based on your budget
# 5. Use a secure MongoDB connection with authentication

# Campaign Platform - Environment Configuration
# Copy this file to .env and update values as needed

# ============== DATABASE ==============
# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/

# ============== SERVER ==============
# API base URL (used for email tracking links)
API_BASE=http://localhost:8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ============== AUTHENTICATION ==============
# Secret key for session token signing (CHANGE IN PRODUCTION!)
SESSION_SECRET=your-super-secret-key-change-in-production

# Session TTL in seconds (default: 24 hours)
SESSION_TTL_SECONDS=86400

# Default admin credentials (created on first startup if no admin exists)
# ⚠️ IMPORTANT: Change these in production and update password via Profile page
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=password123

# ============== CPX RESEARCH API ==============
# CPX Research credentials for survey inventory
CPX_APP_ID=
CPX_EXT_USER_ID=
CPX_SECURE_HASH_KEY=

# API timeout in seconds
CPX_API_TIMEOUT=30

# Maximum surveys to fetch per request
CPX_FETCH_LIMIT=1000

# ============== AI PROVIDER (Anthropic Messages API ONLY) ==============
# Ladder: rules -> Haiku -> Sonnet -> review queue (platform_core/ladder.py).
# All calls go through backend/ai_governance (daily limits + audit logging).
# Get a key from: https://platform.claude.com/

ANTHROPIC_API_KEY=

# Models are set in the ladder config (platform_core/ladder.py): claude-haiku-5-5 (tier 1)
# and claude-sonnet-5-5 (tier 2). The ladder reads no model env var.
# Optional overrides, read only by ai_governance/claude_gateway.py and lead_gen_mcp/llm_client.py:
# LLM_MODEL_FAST=claude-haiku-5-5
# LLM_MODEL_SMART=claude-sonnet-5-5
# LLM_MODEL_WEB_SEARCH=claude-haiku-5-5

# Set to 'true' to disable all AI calls (emergency cost control)
DISABLE_AI_CALLS=false

# Hard daily AI request cap (ai_governance/governance_checks.py). Default 50000.
# AI_DAILY_LIMIT=50000
# Legacy fallback, read only when AI_DAILY_LIMIT is unset:
# GEMINI_DAILY_LIMIT=50000

# Mail-AI (sales/mail_pool_ai.py, sales/mail_ai_switch.py). Master switch is OFF by default.
# MAIL_AI_ENABLED=false
# MAIL_AI_ANALYSIS_ROLE=cheap
# MAIL_AI_WRITER_ROLE=smart
# MAIL_AI_ANALYSIS_MAX_TOKENS=1500
# MAIL_AI_SCAN_MAX_TOKENS=2500
# MAIL_AI_MAX_PER_RUN=200
# MAIL_AI_PREFILTER_ENABLED=true
# MAIL_AI_PREFILTER_MIN_CONFIDENCE=0.5
# MAIL_AI_PREFILTER_AUDIT_SAMPLE=20
# MAIL_AI_RFQ_PIPELINE=two_stage

# ============== GOOGLE APIS ==============
# Google Custom Search API key
GOOGLE_API_KEY=

# Google Custom Search Engine ID
GOOGLE_CSE_ID=

# Path to Google Sheets service account JSON
GOOGLE_SHEETS_SERVICE_ACCOUNT=

# Google CSE Rate Limiting (for $50/month budget)
# Daily query limit
GOOGLE_CSE_DAILY_LIMIT=400

# Hourly query limit
GOOGLE_CSE_HOURLY_LIMIT=50

# Delay between queries in seconds
GOOGLE_CSE_QUERY_DELAY=3

# Monthly budget in USD
GOOGLE_CSE_MONTHLY_BUDGET=50.0

# Enable rate limiting
GOOGLE_CSE_RATE_LIMIT_ENABLED=true

# ============== EMAIL/IMAP ==============
# Default IMAP settings (can be overridden per account)
# IMAP_SERVER=imap.gmail.com
# IMAP_PORT=993
# IMAP_USE_SSL=true

# ============== LOGGING ==============
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============== DEVELOPMENT ==============
# Enable debug mode (additional logging, error details)
DEBUG=false

# ============== PRODUCTION NOTES ==============
# 1. ALWAYS change SESSION_SECRET in production
# 2. Use strong, unique API keys
# 3. Set appropriate CORS_ORIGINS for your domains
# 4. Configure rate limits based on your budget
# 5. Use a secure MongoDB connection with authentication

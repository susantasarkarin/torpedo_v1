# Campaign Platform - Environment Configuration
# Copy this file to .env and update values as needed

# ============== DATABASE ==============
# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/

# ============== SERVER ==============
# API base URL (used for email tracking links)
API_BASE=http://localhost:8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ============== AUTHENTICATION ==============
# Secret key for session token signing (CHANGE IN PRODUCTION!)
SESSION_SECRET=your-super-secret-key-change-in-production

# Session TTL in seconds (default: 24 hours)
SESSION_TTL_SECONDS=86400

# Default admin credentials (created on first startup if no admin exists)
# ⚠️ IMPORTANT: Change these in production and update password via Profile page
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=password123

# ============== CPX RESEARCH API ==============
# CPX Research credentials for survey inventory
CPX_APP_ID=
CPX_EXT_USER_ID=
CPX_SECURE_HASH_KEY=

# API timeout in seconds
CPX_API_TIMEOUT=30

# Maximum surveys to fetch per request
CPX_FETCH_LIMIT=1000

# ============== AI PROVIDERS ==============
# Gemini is the DEFAULT provider (FREE with multi-key rotation)

# RECOMMENDED: Add 6-7 Gemini API keys for FREE tier
# Get keys from: https://aistudio.google.com/
# Free limits per key: 1000 RPD, 15 RPM, 1M TPM

# Option 1: Comma-separated Gemini keys
GEMINI_API_KEYS=key1,key2,key3,key4,key5,key6,key7

# Option 2: Numbered keys
# GEMINI_API_KEY_1=AIza...
# GEMINI_API_KEY_2=AIza...
# ...up to GEMINI_API_KEY_20

# Option 3: Single key (limited capacity)
# GEMINI_API_KEY=AIza...

# Default AI provider: gemini (FREE), openai, deepseek, or anthropic
# RECOMMENDED: Use 'deepseek' for OpenAI-compatible tasks (50% cheaper than OpenAI)
AI_DEFAULT_PROVIDER=gemini

# FALLBACK: OpenAI API (costs ~$0.15/1K requests)
OPENAI_API_KEY=

# DeepSeek API (OpenAI-compatible, 50% cheaper, no daily limits)
DEEPSEEK_API_KEY=

# Set to 'true' to disable all AI calls (emergency cost control)
DISABLE_AI_CALLS=false

# Daily AI budget limit in USD (prevents runaway costs)
# Set to 0 to disable budget checking
DAILY_AI_BUDGET_USD=10.0

# ============== GOOGLE APIS ==============
# Google Custom Search API key
GOOGLE_API_KEY=

# Google Custom Search Engine ID
GOOGLE_CSE_ID=

# Path to Google Sheets service account JSON
GOOGLE_SHEETS_SERVICE_ACCOUNT=

# Google CSE Rate Limiting (for $50/month budget)
# Daily query limit
GOOGLE_CSE_DAILY_LIMIT=400

# Hourly query limit
GOOGLE_CSE_HOURLY_LIMIT=50

# Delay between queries in seconds
GOOGLE_CSE_QUERY_DELAY=3

# Monthly budget in USD
GOOGLE_CSE_MONTHLY_BUDGET=50.0

# Enable rate limiting
GOOGLE_CSE_RATE_LIMIT_ENABLED=true

# ============== EMAIL/IMAP ==============
# Default IMAP settings (can be overridden per account)
# IMAP_SERVER=imap.gmail.com
# IMAP_PORT=993
# IMAP_USE_SSL=true

# ============== LOGGING ==============
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============== DEVELOPMENT ==============
# Enable debug mode (additional logging, error details)
DEBUG=false

# ============== PRODUCTION NOTES ==============
# 1. ALWAYS change SESSION_SECRET in production
# 2. Use strong, unique API keys
# 3. Set appropriate CORS_ORIGINS for your domains
# 4. Configure rate limits based on your budget
# 5. Use a secure MongoDB connection with authentication

# QRE Survey Platform — Environment Variables
# Copy this file to .env and fill in your values

# MongoDB connection
MONGO_URI=mongodb://localhost:27017
DB_NAME=qre_health_survey

# Total sample target
TOTAL_SAMPLE=2100

# Admin panel credentials
ADMIN_PASSWORD=changeme_admin_pass
CLIENT_PASSWORD=changeme_client_pass

# CORS allowed origins (space-separated)
CORS_ORIGINS=https://torpedo.cogentixresearch.com,http://localhost:5173

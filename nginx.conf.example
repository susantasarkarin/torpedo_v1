# Nginx configuration for Campaign Platform
# Place this in /etc/nginx/sites-available/campaign_platform
# Then symlink: sudo ln -s /etc/nginx/sites-available/campaign_platform /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name torpedo.cogentixresearch.com;
    
    # Redirect HTTP to HTTPS (if using SSL)
    # return 301 https://$server_name$request_uri;
    
    root /var/www/html;
    index index.html;
    
    # API routes that need to be proxied to backend (port 8000)
    
    # CPX callback endpoint
    location /cpx-response {
        proxy_pass http://localhost:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    # Survey allocation endpoints
    location /survey-allocation/ {
        proxy_pass http://localhost:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    # Takesurvey endpoint
    location /takesurvey {
        proxy_pass http://localhost:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    # Health check endpoint
    location /health {
        proxy_pass http://localhost:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    # All other routes - serve React app
    location / {
        try_files $uri $uri/ /index.html;
    }
    
    # Optional: Serve static files with caching
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}

# HTTPS server block (if using SSL with Let's Encrypt)
# Uncomment and configure if using HTTPS
# server {
#     listen 443 ssl http2;
#     server_name torpedo.cogentixresearch.com;
#     
#     ssl_certificate /etc/letsencrypt/live/torpedo.cogentixresearch.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/torpedo.cogentixresearch.com/privkey.pem;
#     
#     # Include the same location blocks as above
#     # ...
# }
